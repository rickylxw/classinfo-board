{
  "name": "classinfo-board",
  "private": true,
  "version": "2.11.0",
  "license": "GPL-3.0-or-later",
  "description": "开源班级课程管理工具：课表 / 作业 / 共享板 / 群消息阅读（桌面端）",
  "type": "module",
  "author": "rickylxw",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "apk": "vite build && npx cap sync android && cd android && gradlew assembleDebug",
    "desktop": "electron desktop/main.mjs",
    "desktop:build": "electron-builder --win portable"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.1.0",
    "electron": "*",
    "electron-builder": "*"
  },
  "build": {
    "appId": "io.github.rickylxw.classinfoboard.desktop",
    "productName": "classinfo-board",
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "desktop/**",
      "public/icons/icon-512.png",
      "public/icons/icon-192.png"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-512.png"
    },
    "portable": {
      "artifactName": "classinfo-board-desktop-${version}.exe"
    }
  }
}
